{
  "$schema": "https://json.schemastore.org/eas.json",
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "yarn": "1.22.22",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1"
      }
    },
    "production": {
      "yarn": "1.22.22",
      "android": {
        "buildType": "app-bundle",
        "image": "latest"
      },
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1"
      }
    }
  }
}
