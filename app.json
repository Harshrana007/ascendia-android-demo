{
  "expo": {
    "name": "Ascendia",
    "slug": "ascendiaapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ascendia",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.example.ascendia",
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/branding/ascendia-app-icon.png",
        "backgroundColor": "#080D20"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080D20",
          "image": "./assets/images/branding/ascendia-app-icon.png",
          "imageWidth": 128,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#080D20",
            "image": "./assets/images/branding/ascendia-app-icon.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/branding/ascendia-app-icon.png",
    "owner": "gutzx007s",
    "extra": {
      "eas": {
        "projectId": "37e224d5-0ad5-4708-a1d4-c9b5f95a76d6"
      }
    }
  }
}
